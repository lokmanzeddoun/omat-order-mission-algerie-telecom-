# Database configuration
# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL="postgresql://username:password@localhost:5432/omat_mission_db"

# JWT configuration for authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server configuration
PORT=3000
NODE_ENV="development"

# Comma-separated exact browser origins allowed to call the API with cookies.
# Leave empty for the agreed same-origin production deployment.
CORS_ORIGINS=""

# QR codes on the PDFs (ordre / décompte)
# Address of the client that phones on the company network can reach, including
# the /omat base path. Scanning opens <APP_PUBLIC_URL>/scan/<ordre|decompte>/<id>.
# Leave empty to print the PDFs without a QR code (never use localhost here).
APP_PUBLIC_URL=""
