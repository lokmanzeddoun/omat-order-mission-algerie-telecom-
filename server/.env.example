# The server refuses to boot when this file is incomplete or weak
# (see src/common/configs/env.validation.ts).

# Database configuration
# PostgreSQL connection string
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL="postgresql://username:password@localhost:5432/omat_mission_db"
# Optional: e2e test database (must end in _test; wiped by every run).
# Defaults to DATABASE_URL pointed at omat_test.
# DATABASE_URL_TEST="postgresql://username:password@localhost:5432/omat_test"

# JWT secrets: at least 32 characters each, and different from each other.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
# Access-token lifetime (the refresh session lasts 7 days).
JWT_EXPIRES_IN="15m"

# Encrypts the admins' TOTP secrets in the database (at least 32 characters,
# different from the JWT secrets). Changing it forces every admin to re-enroll.
MFA_ENCRYPTION_KEY=""
# ADMIN / SUPER_ADMIN must pass TOTP MFA. "false" is accepted in development
# only (e.g. for the Playwright suite).
AUTH_MFA_REQUIRED="true"
# Login / MFA attempts per minute per IP and account.
AUTH_RATE_LIMIT=5

# Server configuration
PORT=8000
NODE_ENV="development"
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Express "trust proxy". Behind the nginx reverse proxy set it to 1 (one hop)
# so client IPs (rate limits, logs) come from X-Forwarded-For. Leave empty
# when the API is reached directly.
TRUST_PROXY=""

# Comma-separated exact browser origins allowed to call the API with cookies.
# Leave empty for the agreed same-origin production deployment.
CORS_ORIGINS=""

# Public address of the client, including the /omat base path. Required in
# production: QR codes on the PDFs and the refresh/logout Origin check use it.
# Scanning opens <APP_PUBLIC_URL>/scan/<ordre|decompte>/<id>.
# Leave empty in development to print the PDFs without a QR code (never use
# localhost here).
APP_PUBLIC_URL=""
