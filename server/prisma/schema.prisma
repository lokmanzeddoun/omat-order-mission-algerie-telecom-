
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  matricule Int @id 
  nom String 
  prenom String
  email String @unique
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  password String
  role Role
  status Status? @default(INACTIVE)
  userSince DateTime?
  grade String
  category Category
  structure Structure? @relation(fields: [serviceId], references: [code])
  serviceId String? 
  soft_delete Boolean? @default(false)
  missions Mission[]
}

model Structure {
  code String  @id
  name String
  soft_delete Boolean? @default(false)
  users User[]
}
model Mission {
  n_mission Int @default(autoincrement()) @id
  date_sortie DateTime?
  heure_sortie String?
  date_retour DateTime?
  heure_retour String?
  motif String?
  status MissionStatus? @default(INPROGRESS)
  transport TransportType?
  destination String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId],references: [matricule])
  soft_delete Boolean @default(false)
  userId Int
  direction Direction @default(NORD)
  decompte Decompte[]
}

model Decompte {
  n_decompte Int @default(autoincrement()) @id
  repas_pec Int @default(0)
  repas_sans_pec Int @default(0)
  hebergement_pec Int @default(0)
  hebergement_sans_pec Int @default(0)
  status DecompteStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  soft_delete Boolean @default(false)
  mission Mission @relation(fields: [missionId],references: [n_mission])
  missionId Int
}


enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}
enum Status {
  ACTIVE
  INACTIVE
}

enum Category {
  CADRE
  CADRE_SUPERIEUR
  EXECUTION_MAITRISE
}

enum TransportType {
  SERVICE_CAR 
  PERSONAL_CAR
  TRANSPORT_ENTREPRISE
  TRANSPORT_EMPLOYEE
}
enum Direction {
  NORD
  SUD
}
enum MissionStatus {
  PENDING
  INPROGRESS
  COMPLETED
}
enum DecompteStatus {
  REGECTED
  ACCEPTED
  PENDING
}