
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  matricule Int @id
  nom String
  prenom String
  email String @unique
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  password String
  role Role
  status Status? @default(INACTIVE)
  userSince DateTime?
  grade String
  category Category
  structure Structure? @relation(fields: [serviceId], references: [code])
  serviceId String?
  soft_delete Boolean? @default(false)
  archivedAt DateTime?
  archivedBy User? @relation("UserArchivedBy", fields: [archivedById], references: [matricule], onDelete: SetNull)
  archivedById Int?
  missions Mission[]
  messages Commentaire[]
  archivedUsers User[] @relation("UserArchivedBy")
  archivedStructures Structure[] @relation("StructureArchivedBy")
  responsibleFor Structure? @relation("StructureResponsible")
  archivedMissions Mission[] @relation("MissionArchivedBy")
  gradeAssignments GradeAssignment[] @relation("GradeAssignmentUser")
  gradeAssignmentsCreated GradeAssignment[] @relation("GradeAssignmentCreatedBy")
  archivedDecomptes Decompte[] @relation("DecompteArchivedBy")
  // Sessions & credentials (ADR 0002)
  sessions Session[]
  // Access tokens issued before this instant are refused; so are sessions opened before it.
  passwordChangedAt DateTime?
  // Set on a temporary password (creation, admin reset): every route but the
  // password change is refused until the user picks their own.
  mustChangePassword Boolean @default(false)
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  // TOTP MFA (ADMIN / SUPER_ADMIN). Secrets are AES-256-GCM encrypted.
  mfaSecret String?
  mfaPendingSecret String?
  mfaEnabledAt DateTime?
  // Last accepted TOTP time step, so a code cannot be replayed.
  mfaLastStep Int?
  // sha256 hashes of the unused recovery codes.
  mfaRecoveryCodes String[] @default([])
}

/// A refresh-token session. The cookie holds `<id>.<secret>`; only an HMAC of
/// the secret is stored. Rotation creates a new row in the same family;
/// presenting a rotated (or revoked) token revokes the whole family.
model Session {
  id String @id @default(uuid())
  user User @relation(fields: [userMatricule], references: [matricule], onDelete: Cascade)
  userMatricule Int
  familyId String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?
  ip String?

  @@index([userMatricule])
  @@index([familyId])
}

model Structure {
  code String  @id
  name String
  soft_delete Boolean? @default(false)
  archivedAt DateTime?
  archivedBy User? @relation("StructureArchivedBy", fields: [archivedById], references: [matricule], onDelete: SetNull)
  archivedById Int?
  users User[]
  // Hierarchy (ADR 0004). A root's code is its abbreviation; a child's code is its
  // full path ("SDC / ERSTC / Section ..."), so a descendant's code always starts
  // with its ancestor's code + " / ". `name` is the structure's own segment.
  parentCode String?
  parent Structure? @relation("StructureTree", fields: [parentCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  children Structure[] @relation("StructureTree")
  // The structure's responsible (must belong to it); a user is responsible for at most one structure.
  responsibleUserId Int? @unique @map("responsible_user_id")
  responsible User? @relation("StructureResponsible", fields: [responsibleUserId], references: [matricule], onDelete: SetNull)

  @@index([parentCode])
}
model Mission {
  n_mission Int @default(autoincrement()) @id
  // Store full datetime (date + time) in a single field
  date_sortie DateTime?
  // Return datetime (date + time) stored in a single field
  date_retour DateTime?
  motif String?
  status MissionStatus? @default(INPROGRESS)
  transport TransportType?
  destination String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId],references: [matricule])
  soft_delete Boolean @default(false)
  archivedAt DateTime?
  archivedBy User? @relation("MissionArchivedBy", fields: [archivedById], references: [matricule], onDelete: SetNull)
  archivedById Int?
  hors_wilaya Boolean @default(false)
  userId Int
  direction Direction @default(NORD)
  // Who validated this ordre de mission, and when (ADR 0001; audit lands in issue 07).
  // The lock itself is derived from `status`, so there is no separate lockedAt.
  validatedById Int?
  validatedAt DateTime?
  decompte Decompte[]
  // Category the barème is read from, frozen at creation from the agent's
  // category and any Interim/Remplaçant period covering date_sortie.
  // Null only on a row written before the snapshot existed (migration backfills those).
  effectiveCategory Category?
  // The period that raised effectiveCategory; null when the agent's own category applies.
  gradeAssignment GradeAssignment? @relation(fields: [gradeAssignmentId], references: [id])
  gradeAssignmentId Int?
  // Exercice relation
  exercice   Exercice? @relation(fields: [exerciceId], references: [id])
  exerciceId Int?
}

model Decompte {
  n_decompte Int @default(autoincrement()) @id
  // Meals and nights per zone: each is priced at its own Direction's barème.
  repas_pec_nord Int @default(0)
  repas_pec_sud Int @default(0)
  repas_sans_pec_nord Int @default(0)
  repas_sans_pec_sud Int @default(0)
  hebergement_pec_nord Int @default(0)
  hebergement_pec_sud Int @default(0)
  hebergement_sans_pec_nord Int @default(0)
  hebergement_sans_pec_sud Int @default(0)
  montant Float
  parcours Float?
  fees_transport Float? @default(0)
  status DecompteStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  soft_delete Boolean @default(false)
  archivedAt DateTime?
  archivedBy User? @relation("DecompteArchivedBy", fields: [archivedById], references: [matricule], onDelete: SetNull)
  archivedById Int?
  // Who accepted/rejected this décompte, and when (ADR 0001; audit lands in issue 07).
  // The lock is derived from `status` (ACCEPTED/REGECTED are read-only), so no lockedAt.
  decidedById Int?
  decidedAt DateTime?
  mission Mission @relation(fields: [missionId],references: [n_mission])
  missionId Int
  messages Commentaire[]
  // Barème rates frozen when the décompte is settled, so a later barème edit
  // or category change never moves an existing amount. Null only on legacy rows.
  barem_repas_nord Float?
  barem_hebergement_nord Float?
  barem_repas_sud Float?
  barem_hebergement_sud Float?
  barem_montant_km Float?
  // Exercice relation (denormalized for easier querying)
  exercice   Exercice? @relation(fields: [exerciceId], references: [id])
  exerciceId Int?
}

model Commentaire {
  id Int @default(autoincrement()) @id
  title String
  type MessageType
  status String
  user User @relation(fields: [userId],references: [matricule])
  userId Int
  // Make decompte optional so comments can be generic support tickets (e.g., forget-password)
  decompte Decompte? @relation(fields: [decompteId],references: [n_decompte])
  decompteId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  soft_delete Boolean @default(false)
}

model Barem {
  id Int @default(autoincrement()) @id
  libell Category
  repas_nord Float
  hebergement_nord Float
  repas_sud Float
  hebergement_sud Float
  montant_km Float
}

/// A bounded period during which a user holds a higher category (CONTEXT.md:
/// Intérim / Remplaçant). Never deleted, only ended early (`endedAt`); the
/// user's own `category` is never edited.
model GradeAssignment {
  id Int @id @default(autoincrement())
  user User @relation("GradeAssignmentUser", fields: [userId], references: [matricule])
  userId Int
  kind GradeAssignmentKind
  targetCategory Category
  // Calendar days (Africa/Algiers), both inclusive.
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  decisionRef String
  endedAt DateTime?
  createdAt DateTime @default(now())
  createdBy User? @relation("GradeAssignmentCreatedBy", fields: [createdById], references: [matricule], onDelete: SetNull)
  createdById Int?
  missions Mission[]

  @@index([userId, startDate])
}

model Exercice {
  id        Int       @id @default(autoincrement())
  // e.g., 2024
  year      Int       @unique
  start     DateTime?
  end       DateTime?
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  missions  Mission[]
  decomptes Decompte[]
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  actorMatricule  Int?
  action          String
  entity          String
  entityId        String
  before          Json?
  after           Json?
  reason          String?
  ip              String?
  at              DateTime @default(now())

  @@index([actorMatricule, at])
  @@index([entity, entityId, at])
}


enum GradeAssignmentKind {
  INTERIM
  REMPLACANT
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}
enum Status {
  ACTIVE
  INACTIVE
}

enum Category {
  CADRE
  CADRE_SUPERIEUR
  EXECUTION_MAITRISE
}

enum TransportType {
  SERVICE_CAR
  PERSONAL_CAR
  TRANSPORT_ENTREPRISE
  TRANSPORT_EMPLOYEE
}
enum Direction {
  NORD
  SUD
  // A trip spent partly in the Nord and partly in the Sud.
  MIXTE
}
enum MissionStatus {
  INPROGRESS
  COMPLETED
}
enum DecompteStatus {
  REGECTED
  ACCEPTED
  PENDING
}

enum MessageType {
  FORGET_PASSWORD
  DECOMPTE_STATUS
  OTHER
}
